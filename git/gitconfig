[include]
    path = "~/sv/delta/catppuccin.gitconfig"

[user]
    email = jleen@saturnvalley.org
    name = John Leen

[core]
    pager = delta
    quotepath = off

[delta]
    features = catppuccin-frappe
    navigate = true

[diff]
    submodule = log
    tool = nvimdiff

[difftool]
    prompt = false

[interactive]
    diffFilter = delta --color-only

[init]
    defaultBranch = main

[merge]
    conflictStyle = zdiff3

[pull]
    rebase = true

[status]
    submoduleSummary = true

[submodule]
    recurse = true

[push]
    autoSetupRemote = true
